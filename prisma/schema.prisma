  mappingStatus     ConceptMappingStatus @default(SOURCE_ONLY)
  source            String               @default("sync")
  sourceVersion     String?
  ordinal           Int                  @default(0)
  createdAt         DateTime             @default(now())

  @@index([caseId])
  @@index([category, value])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

enum ResearchCohortVisibility {
  PRIVATE
  INSTITUTION
}

enum ResearchExportStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

model ResearchAccessGrant {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation("ResearchAccessSubject", fields: [userId], references: [id], onDelete: Cascade)
  institutionId   String?
  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  allInstitutions Boolean      @default(false)
  canInspectCases Boolean      @default(true)
  canExport       Boolean      @default(false)
  canExportOmop   Boolean      @default(false)
  grantedById     String
  grantedBy       User         @relation("ResearchAccessGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, revokedAt])
  @@index([institutionId])
  @@index([expiresAt])
}

model ResearchCohort {
  id            String                   @id @default(cuid())
  ownerId       String
  owner         User                     @relation("ResearchCohortOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  institutionId String?
  institution   Institution?             @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  visibility    ResearchCohortVisibility @default(PRIVATE)
  definition    Json
  lastRunAt     DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([ownerId, updatedAt])
  @@index([institutionId, visibility])
}

model ResearchExport {
  id                      String               @id @default(cuid())
  ownerId                 String
  owner                   User                 @relation("ResearchExportOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  institutionId           String?
  institution             Institution?         @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  name                    String
  format                  String
  status                  ResearchExportStatus @default(PENDING)
  definition              Json
  definitionHash          String?
  snapshotRevisions       Json?
  snapshotHash            String?
  snapshotCaseCount       Int?
  revisionManifestVersion Int                  @default(2)
  scopeInstitutionIds     String[]             @default([])
  asOf                    DateTime?
  sourceVersion           String?
  sourceCommit            String?
  rowCount                Int?
  checksum                String?
  artifactKey             String?
  artifactFilename        String?
  artifactContentType     String?
  artifactByteSize        BigInt?
  artifactExpiresAt       DateTime?
  artifactDeletedAt       DateTime?
  workingArtifactKeys     Json?
  error                   String?
  attemptCount            Int                  @default(0)
  leaseOwner              String?
  leaseExpiresAt          DateTime?
  generatedAt             DateTime?
  legacy                  Boolean              @default(false)
  createdAt               DateTime             @default(now())
  startedAt               DateTime?
  completedAt             DateTime?

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([artifactExpiresAt, artifactDeletedAt])
}
