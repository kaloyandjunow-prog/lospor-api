generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id                          String                               @id @default(cuid())
  email                       String                               @unique
  name                        String
  firstName                   String                               @default("")
  lastName                    String                               @default("")
  title                       String                               @default("")
  passwordHash                String
  role                        UserRole                             @default(MEMBER)
  institutionId               String?
  institution                 Institution?                         @relation("UserPrimaryInstitution", fields: [institutionId], references: [id])
  cases                       Case[]
  roleRequests                RoleRequest[]
  institutionChangeRequests   InstitutionChangeRequest[]
  transfersSent               CaseTransfer[]                       @relation("TransfersSent")
  transfersReceived           CaseTransfer[]                       @relation("TransfersReceived")
  emailVerificationTokens     EmailVerificationToken[]
  researchCohorts             ResearchCohort[]                     @relation("ResearchCohortOwner")
  researchExports             ResearchExport[]                     @relation("ResearchExportOwner")
  researchAccessGrants        ResearchAccessGrant[]                @relation("ResearchAccessSubject")
  researchGrantsIssued        ResearchAccessGrant[]                @relation("ResearchAccessGrantor")
  clinicalRuleReviews         ClinicalRuleReview[]                 @relation("ClinicalRuleReviewer")
  clinicalPresetsCreated      ClinicalPreset[]                     @relation("ClinicalPresetCreator")
  clinicalPresetsPublished    ClinicalPreset[]                     @relation("ClinicalPresetPublisher")
  clinicalPresetsOwned        ClinicalPreset[]                     @relation("ClinicalPresetUserOwner")
  clinicalPresetSelections    UserClinicalPresetSelection[]
  platformPresetSelections    PlatformClinicalPresetSelection[]
  institutionPresetSelections InstitutionClinicalPresetSelection[]
  clinicalOverridesToReview   InstitutionClinicalRuleOverride[]    @relation("ClinicalRuleDesignatedReviewer")
  clinicalOverridesApproved   InstitutionClinicalRuleOverride[]    @relation("ClinicalRuleHodApprover")
  clinicalOverridesProposed   InstitutionClinicalRuleOverride[]    @relation("ClinicalRuleProposer")
  passwordResetTokens         PasswordResetToken[]
  approvedAt                  DateTime?
  emailVerifiedAt             DateTime?
  acceptedTermsAt             DateTime?
  acceptedPrivacyAt           DateTime?
  termsVersion                String?
  preferences                 Json                                 @default("{}")
  lastLoginAt                 DateTime?
  // Token-revocation epoch: any JWT (web session or mobile bearer) whose iat
  // predates this is rejected — set on password reset so old sessions die.
  passwordChangedAt           DateTime?
  deletedAt                   DateTime?
  createdAt                   DateTime                             @default(now())
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

enum UserRole {
  MEMBER
  HEAD_OF_DEPT
  ADMIN
  CLINICIAN // legacy
  RESEARCHER // legacy
}

model Institution {
  id                       String                               @id @default(cuid())
  name                     String
  city                     String
  country                  String                               @default("Bulgaria")
  users                    User[]                               @relation("UserPrimaryInstitution")
  institutionChangeRequests InstitutionChangeRequest[]          @relation("RequestedInstitution")
  cases                    Case[]
  researchCohorts          ResearchCohort[]
  researchExports          ResearchExport[]
  researchAccessGrants     ResearchAccessGrant[]
  clinicalRuleOverrides    InstitutionClinicalRuleOverride[]
  clinicalPresets          ClinicalPreset[]                     @relation("ClinicalPresetInstitutionOwner")
  clinicalPresetSelections InstitutionClinicalPresetSelection[]
}

// ─── Case ────────────────────────────────────────────────────────────────────

model Case {
  id                   String       @id @default(cuid())
  caseCode             String?
  notes                String?
  userId               String
  user                 User         @relation(fields: [userId], references: [id])
  institutionId        String?
  institution          Institution? @relation(fields: [institutionId], references: [id])
  status               CaseStatus   @default(DRAFT)
  clinicalMode         ClinicalMode @default(ADULT)
  clinicalRulesVersion String?
  finalizedAt          DateTime?
  clientDraftId        String?
  clinicalRevision     Int          @default(0)
  eventRevision        Int          @default(0)
  relationalRevision   Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  preop                PreoperativeAssessment?
  intraop              IntraoperativeRecord?
  postop               PostoperativeRecord?
  transfers            CaseTransfer[]
  lock                 CaseLock?
  events               CaseEvent[]
  selections           CaseSelection[]
  complications        CaseComplication[]
  fieldStatuses        ClinicalFieldStatus[]
  fieldChanges         CaseFieldChange[]
  finalizations        CaseFinalization[]
  clinicalCalculations CaseClinicalCalculation[]

  @@unique([userId, caseCode])
  @@unique([userId, clientDraftId])
  @@index([status])
  @@index([userId, createdAt])
}

model CaseLock {
  caseId    String   @id
  userId    String
  deviceId  String
  expiresAt DateTime

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// The next case number to issue, per clinician per year.
///
/// Case codes used to be derived from the highest code a clinician currently
/// owned. A handover changes what they own, so that ceiling could move
/// backwards: hand away your highest case and the next case you create takes
/// the number you just handed over -- a number already printed on that chart.
/// The unique constraint is [userId, caseCode] and the handed-over case now
/// belongs to someone else, so nothing prevented it.
///
/// A counter only ever moves forward. Gaps are fine and always were (a deleted
/// draft leaves one); reuse is not, because the number is the only thing tying
/// a paper chart to its record.
model CaseCodeSequence {
  userId String
  year   Int
  /// The next number to hand out. Incremented in the same transaction as the
  /// write that consumes it, so a rolled-back case does not burn a number.
  next   Int    @default(1)

  @@id([userId, year])
}

model CaseTransfer {
  id               String         @id @default(cuid())
  caseId           String
  case             Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromUserId       String
  fromUser         User           @relation("TransfersSent", fields: [fromUserId], references: [id])
  toUserId         String
  toUser           User           @relation("TransfersReceived", fields: [toUserId], references: [id])
  initiatedBy      String
  status           TransferStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  resolvedAt       DateTime?
  // Case codes are per-user sequences, so a transferred case may have to be
  // renumbered into the recipient's sequence. The code it carried beforehand is
  // kept here — otherwise the paper record and the database disagree with no
  // way to reconcile them.
  previousCaseCode String?

  @@index([status])
  @@index([toUserId, status])
  // Who is waiting to hand a case over, for the sender's own "awaiting
  // acceptance" list. Without it that view scans every transfer ever made.
  @@index([fromUserId, status])
  // One pending handover per case is enforced by a partial unique index created
  // in 20260819120000_member_initiated_handover. Prisma cannot express a
  // `WHERE status = 'PENDING'` index, so it lives in SQL and is deliberately
  // absent here — do not "restore" it as a plain @@unique, which would forbid a
  // case from ever being transferred twice.
}

enum TransferStatus {
  PENDING
  ACCEPTED
  // Refused by the recipient.
  DECLINED
  // Withdrawn by the sender before anyone answered. Distinct from DECLINED
  // because "my colleague refused this case" and "I thought better of it" are
  // different events, and a handover trail that cannot tell them apart cannot
  // answer the question anyone would actually ask of it.
  CANCELLED
}

enum CaseStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_REVIEW
  COMPLETE
}

enum ClinicalMode {
  ADULT
  PEDIATRIC
}

enum PediatricAgeUnit {
  DAYS
  MONTHS
  YEARS
}

enum PediatricPainScale {
  FLACC
  FPS_R
  NRS
}

enum ClinicalRuleReviewStatus {
  PENDING
  APPROVED
  REJECTED
  DEPRECATED
}

enum ClinicalPresetStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ClinicalPresetScope {
  PLATFORM
  INSTITUTION
  USER
}

// ─── Custom terms (free-text entries added by clinicians) ─────────────────────

model RoleRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  resolvedAt  DateTime?
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Asking to move to another institution.
///
/// Choosing an institution at registration is self-service; moving afterwards
/// is not. Institutional membership is what lets a head of department see a
/// clinician's cases, so joining a department is the act that needs that
/// department's consent -- an administrator, or the head of the institution
/// being joined.
///
/// Kept separate from RoleRequest deliberately: the approver differs. A role
/// request is resolved by any administrator, whereas this one can also be
/// resolved by the head of the *requested* institution, and folding both into
/// one table would make that query ambiguous.
model InstitutionChangeRequest {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The institution being joined. Restricted so an institution cannot be
  /// deleted while a request to join it is outstanding.
  requestedInstitutionId String
  requestedInstitution   Institution   @relation("RequestedInstitution", fields: [requestedInstitutionId], references: [id], onDelete: Restrict)
  /// Where the clinician was when they asked, so an approver can see the move
  /// being made and the audit trail survives the change.
  previousInstitutionId  String?
  status                 RequestStatus @default(PENDING)
  requestedAt            DateTime      @default(now())
  resolvedAt             DateTime?
  resolvedById           String?

  @@index([status, requestedInstitutionId])
  @@index([userId])
}

// ICD-10 vocabulary (seeded from WHO ICD-10 + official BG MZ labels)
model Icd10Code {
  code     String         @id // e.g. "I21"
  labelEn  String
  labelBg  String?
  synonyms Icd10Synonym[]
}

model Icd10Synonym {
  id        String    @id @default(cuid())
  icd10Code String
  icd10     Icd10Code @relation(fields: [icd10Code], references: [code], onDelete: Cascade)
  synonym   String

  @@index([icd10Code])
}

// LOINC codes for the 67-test canonical lab library (seeded once, not full LOINC import)
model LabLoinc {
  name          String @id // exact name from lab library
  loincCode     String
  unitCanon     String
  referenceLow  Float?
  referenceHigh Float?
}

// ATC drug classification tree (seeded from Athena CONCEPT.csv, vocab ATC)
model Atc {
  code       String  @id // e.g. "N01AB"
  name       String
  level      Int // 1-5
  parentCode String?

  @@index([parentCode])
  @@index([level])
}

// Drug registry (seeded from drugs.json, searchable by name/INN/ATC)
model Drug {
  id            String          @id @default(cuid())
  name          String
  inn           String?
  atcCode       String?
  form          String?
  strength      String?
  optionLibrary OptionLibrary[]

  @@index([name])
  @@index([inn])
  @@index([atcCode])
}

// Shared selectable option catalog for intraop/preop pill-button pickers
// (position, technique, vascular access, airway management, monitoring,
// premedication/intraop drugs, infusions, inhalational agents, fluids,
// clinical events) — one master library both web and mobile read from,
// instead of each app hardcoding its own copies.
enum LibraryCategory {
  POSITION
  AIRWAY_MANAGEMENT
  VASCULAR_ACCESS
  TECHNIQUE
  MONITORING
  PREMED_DRUG
  INTRAOP_EVENT
  INTRAOP_DRUG
  INTRAOP_INFUSION
  INHALATIONAL_AGENT
  INTRAOP_FLUID

  // Preop/postop categorical pickers
  SEX
  BLOOD_GROUP
  NECK_MOBILITY
  MALLAMPATI
  UPPER_LIP_BITE
  CORMACK_LEHANE
  DISPOSITION
  HANDOVER_ITEM

  // Preop/postop numeric range specs — one row per category, range/step/unit in metadata
  AGE_RANGE
  HEIGHT_RANGE
  WEIGHT_RANGE
  BP_SYSTOLIC_RANGE
  BP_DIASTOLIC_RANGE
  HEART_RATE_RANGE
  SPO2_RANGE
  TEMPERATURE_RANGE
  RESPIRATORY_RATE_RANGE
  MOUTH_OPENING_RANGE
  THYROMENTAL_RANGE
  ALDRETE_SUBSCORE_RANGE
  PAIN_NRS_RANGE
}

model OptionLibrary {
  id          String          @id @default(cuid())
  category    LibraryCategory
  value       String // stable code written into CaseEvent/CaseSelection, e.g. "SUPINE", "PROPOFOL"
  labelEn     String
  labelBg     String?
  group       String? // e.g. premed category "Anxiolytics", drug category "Induction"
  parentId    String? // self-relation for tree categories (TECHNIQUE, VASCULAR_ACCESS)
  parent      OptionLibrary?  @relation("LibraryTree", fields: [parentId], references: [id])
  children    OptionLibrary[] @relation("LibraryTree")
  drugId      String? // optional FK into Drug for ATC/INN
  drug        Drug?           @relation(fields: [drugId], references: [id])
  color       String?
  description String?
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  metadata    Json? // category-specific extras: doseHints, allowedUnits, defaultUnit, etc.
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([category, value])
  @@index([category, active, sortOrder])
  @@index([parentId])
}

enum ConceptMappingStatus {
  /// An automatic resolution found a standard concept for this source code.
  MAPPED
  /// A human reviewed this mapping and chose it. Behaves like MAPPED for
  /// export, but stays distinguishable: an automatic match and a curated one
  /// are different levels of evidence, and a study that treats them alike is
  /// trusting a string-similarity score as if a clinician had signed it off.
  MANUALLY_CURATED
  /// A candidate mapping was considered and rejected. Distinct from UNMAPPED,
  /// which means nobody has looked yet -- without the distinction a rejected
  /// candidate is indistinguishable from unfinished work and gets proposed
  /// again on every review pass. The concept id is never applied.
  REJECTED
  /// The source vocabulary and code are preserved, but no standard concept has
  /// been resolved.
  SOURCE_ONLY
  /// No source vocabulary and code either.
  UNMAPPED
}

enum ClinicalFieldPresence {
  PRESENT
  ABSENT
  UNKNOWN
  NOT_APPLICABLE
  NOT_DOCUMENTED
}

model ConceptMap {
  id                 String               @id @default(cuid())
  domain             String
  sourceVocabulary   String
  sourceCode         String
  sourceLabelEn      String?
  sourceLabelBg      String?
  standardVocabulary String?
  standardConceptId  Int?
  standardLabel      String?
  mappingStatus      ConceptMappingStatus @default(SOURCE_ONLY)
  sourceVersion      String?
  mappingMethod      String?
  mappingConfidence  Float?
  reviewed           Boolean              @default(false)
  reviewedBy         String?
  reviewedAt         DateTime?
  mappingNotes       String?
  athenaVersion      String?
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([domain, sourceVocabulary, sourceCode])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
  @@index([mappingStatus])
  @@index([reviewed])
}

model OmopVocabulary {
  vocabularyId        String   @id
  vocabularyName      String?
  vocabularyReference String?
  vocabularyVersion   String?
  vocabularyConceptId Int?
  importedAt          DateTime @default(now())
}

model OmopDomain {
  domainId        String  @id
  domainName      String?
  domainConceptId Int?
}

model OmopConcept {
  conceptId       Int       @id
  conceptName     String
  domainId        String
  vocabularyId    String
  conceptClassId  String
  standardConcept String?
  conceptCode     String
  validStartDate  DateTime?
  validEndDate    DateTime?
  invalidReason   String?
  importedAt      DateTime  @default(now())

  @@index([vocabularyId, conceptCode])
  @@index([domainId])
  @@index([standardConcept])
  @@index([conceptName])
}

model OmopConceptRelationship {
  id             String    @id @default(cuid())
  conceptId1     Int
  conceptId2     Int
  relationshipId String
  validStartDate DateTime?
  validEndDate   DateTime?
  invalidReason  String?
  importedAt     DateTime  @default(now())

  @@unique([conceptId1, conceptId2, relationshipId])
  @@index([conceptId1, relationshipId])
  @@index([conceptId2, relationshipId])
}

model OmopConceptAncestor {
  id                    String   @id @default(cuid())
  ancestorConceptId     Int
  descendantConceptId   Int
  minLevelsOfSeparation Int?
  maxLevelsOfSeparation Int?
  importedAt            DateTime @default(now())

  @@unique([ancestorConceptId, descendantConceptId])
  @@index([ancestorConceptId])
  @@index([descendantConceptId])
}

model OmopConceptSynonym {
  id                 String   @id @default(cuid())
  conceptId          Int
  conceptSynonymName String
  languageConceptId  Int?
  importedAt         DateTime @default(now())

  @@index([conceptId])
  @@index([conceptSynonymName])
}

model OmopVocabularyImport {
  id                String    @id @default(cuid())
  sourceDirectory   String
  vocabularyVersion String?
  importedTables    Json
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  status            String    @default("started")
  error             String?

  @@index([status])
  @@index([startedAt])
}

model ClinicalFieldStatus {
  id            String                @id @default(cuid())
  caseId        String
  case          Case                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  section       String
  fieldKey      String
  presence      ClinicalFieldPresence
  source        String                @default("sync")
  sourceVersion String?
  updatedAt     DateTime              @updatedAt
  createdAt     DateTime              @default(now())

  @@unique([caseId, section, fieldKey])
  @@index([caseId, section])
  @@index([presence])
}

// Per-field preop/postop audit log (Theme D)
model CaseFieldChange {
  id       String   @id @default(cuid())
  caseId   String
  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  section  String // "preop" | "postop"
  field    String
  oldValue String?
  newValue String?
  userId   String
  at       DateTime @default(now())

  @@index([caseId])
  @@index([caseId, section])
}

// The record of each time a case was finalized.
//
// This replaces CaseSnapshot, which called itself immutable, held `caseId
// @unique`, and was written with an upsert whose update branch replaced both
// the document and its timestamp. A case that was finalized, unfinalized,
// edited and finalized again therefore kept no trace of what was first
// attested to -- the earlier record was gone, and the row that remained
// carried the schemaVersion of the original over the shape of the new one,
// because the update branch never set it.
//
// Corrections append and supersede. Nothing here is ever rewritten: a database
// trigger rejects UPDATE and DELETE, so the guarantee does not depend on every
// future caller remembering it.
model CaseFinalization {
  id            String   @id @default(cuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  // 1 for the first finalization of a case, incrementing per correction.
  sequence      Int
  schemaVersion String
  // Stored as the exact text that was serialized at finalization, not as JSONB.
  // JSONB is normalised on the way in -- key order is not preserved -- so a
  // hash taken over the document before storage can never be recomputed from
  // what comes back out, and an integrity check that cannot be run is worse
  // than none. Nothing queries inside this document; it is read whole.
  snapshotDocument String
  // sha256 over the serialized document, so a stored finalization can be shown
  // to be the one that was attested to. Null only for rows migrated from
  // CaseSnapshot: they were never hashed when they were written, and a hash
  // computed during the migration would attest to nothing while being
  // indistinguishable from one that had been.
  snapshotHash  String?
  finalizedAt   DateTime @default(now())
  // Deliberately not a foreign key, for the same reason AuditLog.userId is not
  // one: this row must outlive the account it names. A cascade would delete the
  // evidence and SetNull would erase who attested to it, and either is a
  // mutation of a record that is supposed to be immutable.
  //
  // Null only for rows migrated from CaseSnapshot, which never recorded it.
  finalizedById String?
  // Why this finalization replaced the previous one. Null on a first
  // finalization, and required by the API on any later one.
  correctionReason         String?
  supersedesFinalizationId String?           @unique
  supersedes               CaseFinalization? @relation("Supersession", fields: [supersedesFinalizationId], references: [id], onDelete: SetNull)
  supersededBy             CaseFinalization? @relation("Supersession")

  @@unique([caseId, sequence])
  @@index([caseId, finalizedAt])
}

model RevokedToken {
  jti       String   @id
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// Immutable, event-sourced clinical events. Written in parallel with the legacy
// IntraoperativeRecord.keyEvents.log JSON (dual-write) — this table is the
// append-only audit trail and the future source of truth for the intraop chart.
model CaseEvent {
  id                String   @id @default(cuid())
  caseId            String
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId            String?
  logicalId         String   @default("") // stable client event id; versions share it
  version           Int      @default(1)
  status            String   @default("active") // active | superseded | deleted
  type              String
  timestamp         DateTime
  label             String?
  value             String?
  unit              String?
  // Typed vital values (populated when type = "vital") so vitals are queryable as columns
  systolic          Int?
  diastolic         Int?
  heartRate         Int?
  spO2              Float?
  etco2             Float?
  temp              Float?
  bgl               Float?
  bglLoincCode      String?
  bglUnitCanon      String?
  // Typed gas settings (populated when type = "gas_start" | "gas_change")
  fgfLitersPerMin   Float?
  carrierGas        String?
  fio2Percent       Float?
  fiAirPercent      Float?
  fiN2OPercent      Float?
  // Coded drug fields (populated when type = "drug")
  atcCode           String?
  drugId            String?
  inn               String?
  drugRoute         String?
  // The standard vocabulary concept for this event's drug, resolved once when
  // the event is written rather than looked up again on every export.
  //
  // Preop medications have worked this way all along; intraoperative drugs did
  // not, so every drug given during a case exported with drug_concept_id 0 even
  // though its ATC was known and mapped. Resolving here keeps the export a pure
  // function of the stored record: the same case exported twice produces the
  // same file, which is what makes a research dataset defensible.
  //
  // SOURCE_ONLY by default, so existing rows keep behaving exactly as before
  // until something resolves them.
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus @default(SOURCE_ONLY)
  // Drug-selection audit fields. `concentration` remains the legacy display
  // value (for example "0.5%"); the typed value/unit pair is canonical for new
  // writes while preserving old rows and clients.
  concentrationValue Float?
  concentrationUnit  String?
  formulation         String?
  calculationBasis    String?
  calculationWeightKg Float?
  calculationMethod   String?
  clinicalRuleKey     String?
  clinicalRuleVersion String?
  clinicalRuleSourceIds Json?
  clinicalPresetId      String?
  clinicalPresetVersion Int?
  clinicalPresetScope   String?
  infId             String?
  fluidId           String?
  rate              String?
  concentration     String?
  volume            String?
  fluidCategory     String?
  agentPercent      Float?
  clinicalEventCode String?
  metadataJson      Json?
  source            String   @default("mobile")
  sourceVersion     String?
  schemaVersion     String?
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([caseId, timestamp])
  @@index([caseId, status])
  // Created by 20260625003000_normalized_remaining_clinical_rows but never
  // reflected back into this schema, so every diff since has proposed dropping
  // them. Declared here to match the database rather than lose the indexes.
  @@index([infId])
  @@index([fluidId])
  @@index([clinicalEventCode])
  @@index([caseId, logicalId])
  @@index([clinicalRuleKey, clinicalRuleVersion])
  @@index([clinicalPresetId, clinicalPresetVersion])
}

model AuditLog {
  id        String   @id @default(cuid())
  // Deliberately NOT a foreign key. Audit rows must outlive the account they
  // describe — a retention purge that hard-deletes a user must not cascade away
  // the evidence of what that user did, and SetNull would erase who acted.
  userId    String
  action    String
  entityId  String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  // "Everything that happened to this case" was a full table scan.
  @@index([entityId, createdAt])
}

model CustomTerm {
  id            String   @id @default(cuid())
  code          String   @unique // "0000000", "0000001", …
  term          String
  termType      String // "procedure" | "diagnosis" | "medication" | "allergy"
  institutionId String? // null = legacy global; set = institution-scoped
  createdAt     DateTime @default(now())

  // Dedupe was read-then-write, which races under concurrent first use of the
  // same term. Let the database be the arbiter. NULL institutionId rows are not
  // covered by this (Postgres treats NULLs as distinct) — that is the legacy
  // global scope and is intentionally left alone.
  @@unique([institutionId, termType, term])
}

