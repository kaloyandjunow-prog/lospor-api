// ─── Normalised clinical/research rows ───────────────────────────────────────
// These mirror JSON arrays on the section records as queryable rows. They are
// written best-effort alongside the JSON (which stays authoritative), so a sync
// failure never blocks a clinical save. caseId is denormalised for research joins.

model PreopDiagnosis {
  id                String                 @id @default(cuid())
  preopId           String
  preop             PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId            String
  code              String?
  label             String
  labelEn           String?
  labelBg           String?
  system            String?
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus   @default(SOURCE_ONLY)
  source            String                 @default("sync")
  sourceVersion     String?
  ordinal           Int                    @default(0)
  createdAt         DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([code])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

model PreopProcedure {
  id                String                 @id @default(cuid())
  preopId           String
  preop             PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId            String
  code              String?
  group             String?
  domain            String?
  description       String?
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus   @default(SOURCE_ONLY)
  source            String                 @default("sync")
  sourceVersion     String?
  ordinal           Int                    @default(0)
  createdAt         DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([code])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

model Comorbidity {
  id                String                 @id @default(cuid())
  preopId           String
  preop             PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId            String
  label             String
  labelEn           String?
  labelBg           String?
  code              String?
  icd10Code         String? // ICD-10 code (Gap 2: comorbidities coded same as diagnoses)
  system            String?
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus   @default(SOURCE_ONLY)
  source            String                 @default("sync")
  sourceVersion     String?
  ordinal           Int                    @default(0)
  createdAt         DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([code])
  @@index([icd10Code])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

model LabResult {
  id                String                 @id @default(cuid())
  preopId           String
  preop             PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId            String
  test              String
  value             String?
  valueNum          Float? // parsed numeric value in canonical unit
  unit              String?
  unitCanon         String? // canonical unit from LabLoinc
  loincCode         String? // LOINC code for this test
  referenceLow      Float?
  referenceHigh     Float?
  abnormalFlag      String? // "low" | "normal" | "high" | "critical"
  takenAt           DateTime?
  source            String? // "manual" | "ai-scan" | "import"
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus   @default(SOURCE_ONLY)
  sourceVersion     String?
  ordinal           Int                    @default(0)
  createdAt         DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([test])
  @@index([loincCode])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

// Preop medications as coded rows (Theme C3; currentMedications JSON kept for backwards compat)
model Medication {
  id                String                 @id @default(cuid())
  preopId           String
  preop             PreoperativeAssessment @relation(fields: [preopId], references: [id], onDelete: Cascade)
  caseId            String
  kind              MedicationKind         @default(CURRENT)
  drugId            String? // FK to Drug if matched
  nameRaw           String // raw label as entered
  inn               String?
  atcCode           String?
  dose              String?
  route             String?
  frequency         String?
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus   @default(SOURCE_ONLY)
  source            String                 @default("sync")
  sourceVersion     String?
  ordinal           Int                    @default(0)
  createdAt         DateTime               @default(now())

  @@index([caseId])
  @@index([preopId])
  @@index([kind])
  @@index([caseId, kind])
  @@index([preopId, kind])
  @@index([atcCode])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

model VascularAccess {
  id                String               @id @default(cuid())
  intraopId         String
  intraop           IntraoperativeRecord @relation(fields: [intraopId], references: [id], onDelete: Cascade)
  caseId            String
  site              String?
  siteLabel         String?
  size              String?
  sizeUnit          String?
  depthCm           String?
  lumens            String?
  preexisting       Boolean              @default(false)
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus @default(SOURCE_ONLY)
  source            String               @default("sync")
  sourceVersion     String?
  ordinal           Int                  @default(0)
  createdAt         DateTime             @default(now())

  @@index([caseId])
  @@index([intraopId])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

model PremedicationAdministration {
  id                String               @id @default(cuid())
  intraopId         String
  intraop           IntraoperativeRecord @relation(fields: [intraopId], references: [id], onDelete: Cascade)
  caseId            String
  phase             String // "evening" | "morning"
  drugId            String?
  nameRaw           String
  inn               String?
  atcCode           String?
  dose              String?
  route             String?
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus @default(SOURCE_ONLY)
  source            String               @default("sync")
  sourceVersion     String?
  ordinal           Int                  @default(0)
  createdAt         DateTime             @default(now())

  @@index([caseId])
  @@index([intraopId])
  @@index([phase])
  @@index([atcCode])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

model CaseComplication {
  id                String               @id @default(cuid())
  caseId            String
  case              Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  section           String // "intraop" | "postop"
  label             String
  note              String?
  timestamp         DateTime?
  source            String?
  eventId           String?
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus @default(SOURCE_ONLY)
  sourceVersion     String?
  ordinal           Int                  @default(0)
  createdAt         DateTime             @default(now())

  @@index([caseId])
  @@index([section])
  @@index([label])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}

// Generic store for controlled-vocabulary multi-selects (positions, techniques,
// airway devices/tools, ventilation modes, handover items).
model CaseSelection {
  id                String               @id @default(cuid())
  caseId            String
  case              Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  section           String // "intraop" | "postop"
  category          String // "position" | "technique" | "airwayTool" | "airwayDevice" | "ventilationMode" | "handoverItem"
  value             String
  sourceVocabulary  String?
  sourceCode        String?
  standardConceptId Int?
  mappingStatus     ConceptMappingStatus @default(SOURCE_ONLY)
  source            String               @default("sync")
  sourceVersion     String?
  ordinal           Int                  @default(0)
  createdAt         DateTime             @default(now())

  @@index([caseId])
  @@index([category, value])
  @@index([sourceVocabulary, sourceCode])
  @@index([standardConceptId])
}
