# PostgreSQL. Use a pooler URL at runtime and a direct URL for migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@host:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@host:5432/postgres"

# Shared signing secret. Keep NEXTAUTH_SECRET equal to this value while V6
# bearer tokens remain supported.
LOSPOR_AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-the-same-long-random-string"

# Public web application origin. Used for CSRF checks, print rendering, and
# account verification/password reset links.
LOSPOR_WEB_URL="https://app.lospor.org"
NEXT_PUBLIC_APP_URL="https://app.lospor.org"
LOSPOR_DATABASE_URL="https://database.lospor.org"

# Installation/device default before login. `GET /v1/locale` validates this;
# missing or unsupported values resolve to Bulgarian. The signed-in account's
# authority is still User.preferences.ui.locale.
LOSPOR_DEFAULT_LOCALE="bg"

# Optional non-secret clinician support destination published through
# /v1/capabilities. Use HTTPS without embedded credentials/fragments or one
# bare mailto: mailbox. Query content on mailto values is discarded.
LOSPOR_SUPPORT_URL=""

# Required exact legal-document manifest. The API computes SHA-256 from each
# UTF-8 `content`, requires separate TERMS and PRIVACY entries in both bg and
# en, and fails readiness instead of falling back to another language. See the
# README for the canonical JSON shape. For the public demo, use the exact
# one-line output of `npm --prefix ../lospor-app run legal:manifest`; do not
# deploy placeholder legal text or a LOCAL_HOSPITAL manifest.
LOSPOR_LEGAL_DOCUMENTS_JSON=""

# Browser/PWA origins allowed to call the API directly.
CORS_ALLOW_ORIGIN="https://pwa.lospor.org"
CORS_ALLOW_ORIGINS="https://app.lospor.org,https://pwa.lospor.org,https://database.lospor.org"

# Transactional email.
BREVO_API_KEY=""
AUTH_EMAIL_FROM="no-reply@lospor.org"
AUTH_EMAIL_FROM_NAME="LOSPOR"

# Authentication is a deployment boundary. The online serverless service must
# remain `public`; a Hospital appliance sets `hospital` only together with the
# account-administration switch below. Partial Hospital configuration fails
# closed and never falls back to public email login.
LOSPOR_DEPLOYMENT_MODE="public"

# Non-sensitive authentication capability reporting. The public deployment
# normally keeps self-registration enabled and uses EMAIL when Brevo is set.
# Local appliances override these through their Hospital-owned control plane.
LOSPOR_SELF_REGISTRATION_ENABLED="true"
LOSPOR_PASSWORD_RECOVERY_MODE=""

# Hospital-only administrator lifecycle controls. The API requires this and
# LOSPOR_DEPLOYMENT_MODE=hospital; the online serverless demo must not use that mode.
LOSPOR_ACCOUNT_ADMINISTRATION_ENABLED="false"

# Offline-capable administrator MFA. Hospital enables this and supplies a
# separate 32-byte base64 key through its API-only secret file. The public demo
# leaves it false unless it deliberately adopts the complete two-step UI.
LOSPOR_ADMIN_MFA_REQUIRED="false"
# Production/Hospital path. This takes precedence and fails closed if unreadable.
LOSPOR_MFA_ENCRYPTION_KEY_FILE=""
# Development-only alternative; use canonical base64 for exactly 32 bytes.
LOSPOR_MFA_ENCRYPTION_KEY=""

# Optional AI services.
MISTRAL_API_KEY=""
# Clinical payloads go to EU inference. This value, not the fallback flag
# below, is what decides data residency.
MISTRAL_API_BASE="https://api.eu.mistral.ai/v1"
# Clinical payloads never leave the selected regional endpoint unless this
# exceptional transfer has been explicitly approved.
MISTRAL_ALLOW_GLOBAL_FALLBACK="false"
MISTRAL_MODEL=""
MISTRAL_VISION_MODEL=""
MISTRAL_TIMEOUT_MS="30000"

# Internal jobs and exports.
CRON_SECRET=""
OPTION_LIBRARY_SNAPSHOT_SECRET=""
OMOP_PSEUDONYM_SALT=""

# Immutable research-export artifacts. Filesystem storage is for local/self-hosted
# development only; Vercel deployments must use an S3-compatible bucket.
RESEARCH_EXPORT_STORAGE_DRIVER="filesystem"
RESEARCH_EXPORT_STORAGE_DIR=".data/research-exports"
RESEARCH_EXPORT_WORKER_SECRET=""
RESEARCH_EXPORT_WORKER_BATCH_SIZE="10"
RESEARCH_EXPORT_RETENTION_DAYS="30"

# Required when RESEARCH_EXPORT_STORAGE_DRIVER="s3".
RESEARCH_EXPORT_S3_BUCKET=""
RESEARCH_EXPORT_S3_PREFIX="research-exports"
RESEARCH_EXPORT_S3_REGION="auto"
RESEARCH_EXPORT_S3_ENDPOINT=""
RESEARCH_EXPORT_S3_FORCE_PATH_STYLE="false"
RESEARCH_EXPORT_S3_ACCESS_KEY_ID=""
RESEARCH_EXPORT_S3_SECRET_ACCESS_KEY=""
# Pediatric mode is enabled automatically in local development. Production
# additionally requires this flag and a Core release whose reviewed clinical
# manifest sets PEDIATRIC_PRODUCTION_READY=true. The current draft must remain
# disabled in production.
PEDIATRIC_MODE_ENABLED="false"


# Artifact uploads use server-side AES-256 encryption and create-only keys.

# Optional local PDF browser override.
CHROME_EXECUTABLE_PATH=""

# Local/test-only flags. Never enable these in production.
# AUTH_EMAIL_TEST_LINKS="true"
# ALLOW_MAINTENANCE_SEED="true"
# SEED_TARGET="development"
# WIPE_DEV_CLINICAL_DATA="true"
