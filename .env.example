# PostgreSQL. Use a pooler URL at runtime and a direct URL for migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@host:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@host:5432/postgres"

# Shared signing secret. Keep NEXTAUTH_SECRET equal to this value while V6
# bearer tokens remain supported.
LOSPOR_AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-the-same-long-random-string"

# Public web application origin. Used for CSRF checks, print rendering, and
# account verification/password reset links.
LOSPOR_WEB_URL="https://app.lospor.org"
NEXT_PUBLIC_APP_URL="https://app.lospor.org"
LOSPOR_DATABASE_URL="https://database.lospor.org"

# Browser/PWA origins allowed to call the API directly.
CORS_ALLOW_ORIGIN="https://pwa.lospor.org"
CORS_ALLOW_ORIGINS="https://app.lospor.org,https://pwa.lospor.org,https://database.lospor.org"

# Transactional email.
BREVO_API_KEY=""
AUTH_EMAIL_FROM="no-reply@lospor.org"
AUTH_EMAIL_FROM_NAME="LOSPOR"

# Optional AI services.
MISTRAL_API_KEY=""
MISTRAL_API_BASE="https://api.mistral.ai/v1"
MISTRAL_MODEL=""
MISTRAL_VISION_MODEL=""
MISTRAL_TIMEOUT_MS="30000"

# Internal jobs and exports.
CRON_SECRET=""
OPTION_LIBRARY_SNAPSHOT_SECRET=""
OMOP_PSEUDONYM_SALT=""

# Immutable research-export artifacts. Filesystem storage is for local/self-hosted
# development only; Vercel deployments must use an S3-compatible bucket.
RESEARCH_EXPORT_STORAGE_DRIVER="filesystem"
RESEARCH_EXPORT_STORAGE_DIR=".data/research-exports"
RESEARCH_EXPORT_WORKER_SECRET=""
RESEARCH_EXPORT_WORKER_BATCH_SIZE="10"
RESEARCH_EXPORT_RETENTION_DAYS="30"

# Required when RESEARCH_EXPORT_STORAGE_DRIVER="s3".
RESEARCH_EXPORT_S3_BUCKET=""
RESEARCH_EXPORT_S3_PREFIX="research-exports"
RESEARCH_EXPORT_S3_REGION="auto"
RESEARCH_EXPORT_S3_ENDPOINT=""
RESEARCH_EXPORT_S3_FORCE_PATH_STYLE="false"
RESEARCH_EXPORT_S3_ACCESS_KEY_ID=""
RESEARCH_EXPORT_S3_SECRET_ACCESS_KEY=""

# Artifact uploads use server-side AES-256 encryption and create-only keys.

# Optional local PDF browser override.
CHROME_EXECUTABLE_PATH=""

# Local/test-only flags. Never enable these in production.
# AUTH_EMAIL_TEST_LINKS="true"
# ALLOW_MAINTENANCE_SEED="true"
# SEED_TARGET="development"
# WIPE_DEV_CLINICAL_DATA="true"
